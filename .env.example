FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-another-long-random-secret
DATABASE_URL=postgresql://postgres:password@host:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-server-side-supabase-key
SUPABASE_STORAGE_BUCKET=petcare
DEMO_ADMIN_EMAIL=admin@petcare.local
DEMO_ADMIN_PASSWORD=PetCare@12345
APP_BASE_URL=http://localhost:5000

# SMS via Twilio. Keep these server-side and never expose them to the browser.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

APP_TIMEZONE=Asia/Kolkata
TWILIO_MESSAGING_SERVICE_SID=
